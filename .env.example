# App origin used in ping URLs and docs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43147

# Local file-store session signing. Generate a long random string for any shared host.
SESSION_SECRET=replace-with-a-long-random-string

# Optional. When set, /api/cron/evaluate requires Bearer or ?secret=.
CRON_SECRET=

# Optional. Local evaluator tick (ms). Set DIDITRUN_LOCAL_SCHEDULER=0 to disable.
DIDITRUN_SCHEDULER_MS=15000

# --- Supabase (production). Leave unset for the local file store. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (transactional alerts). Unset = log + persist a stub delivery. ---
RESEND_API_KEY=
RESEND_FROM=DidItRun <alerts@your-verified-domain>

# File store directory. Vercel without Supabase falls back to /tmp/diditrun.
# DATA_DIR=.data
