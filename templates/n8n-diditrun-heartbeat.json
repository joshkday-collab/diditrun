{
  "name": "DidItRun heartbeat",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "When clicking ‘Test workflow’",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "count",
              "name": "count",
              "value": "={{ $json.count ?? $json.items?.length ?? 0 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "set-count",
      "name": "Resolve record count",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DIDITRUN_URL }}/p/{{ $env.DIDITRUN_CHECK_ID }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "count",
              "value": "={{ $json.count }}"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        }
      },
      "id": "diditrun-ping",
      "name": "Ping DidItRun",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "When clicking ‘Test workflow’": {
      "main": [[{ "node": "Resolve record count", "type": "main", "index": 0 }]]
    },
    "Resolve record count": {
      "main": [[{ "node": "Ping DidItRun", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  }
}
